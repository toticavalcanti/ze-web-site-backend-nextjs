MONGODB_URI=
MONGODB_DB_NAME=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=codigo-fluente
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (usado no reset de senha e na resposta privada ao fã)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente/reply-to dos e-mails de resposta ao fã (ex: robertaramalho@avohaimusic.com)
EMAIL_FROM=
EMAIL_REPLY_TO=

# Segredo do cron da Vercel (gere um valor aleatório longo).
# A Vercel envia "Authorization: Bearer $CRON_SECRET" automaticamente nas execuções agendadas.
CRON_SECRET=
